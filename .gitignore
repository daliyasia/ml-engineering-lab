# Python bytecode and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Virtual environments and Python build artifacts
.venv/
venv/
env/
/build/
/dist/
*.egg-info/
.eggs/

# Private environment variables; keep shareable examples
.env
.env.*
!.env.example
!.env.*.example
/.aws/

# Machine-specific Hydra overrides
/configs/local/**
!/configs/local/**/
!/configs/local/**/.gitkeep

# Downloaded datasets; keep DVC pointers and directory metadata
/data/**
!/data/**/
!/data/**/*.dvc
!/data/**/.gitignore
!/data/**/.gitkeep

# Hydra/Lightning run outputs and experiment tracker state
/logs/
/outputs/
/multirun/
/checkpoints/
/lightning_logs/
/mlruns/
/mlartifacts/
/mlflow.db
/mlflow.db-*
/wandb/
/.aim/
*.ckpt
events.out.tfevents.*

# Scratch files generated by local scripts
/tmp/
/temp/

# DVC local state is excluded by .dvc/.gitignore.
# Keep .dvc/config, .dvcignore, *.dvc, and dvc.lock versioned.

# Notebook checkpoints, editor state, and OS files
.ipynb_checkpoints/
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
